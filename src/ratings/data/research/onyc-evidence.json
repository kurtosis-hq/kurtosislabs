  "facts": [
    {
      "id": "ON-F01",
      "topic": "Economic claim",
      "statement": "Issuer describes ONyc as a NAV-based proportional interest in a Bermuda segregated reinsurance account; it is not a fixed-dollar stablecoin.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S01",
        "ON-S10"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F02",
      "topic": "Identity",
      "statement": "Official reference names the Solana ONyc mint and OnRe program. Addresses have not been independently checked against current chain state.",
      "classification": "document_observation",
      "source_ids": [
        "ON-S02"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null,
      "mint": "5Y8NV33Vv7WbnLfq3zBcKSdYPrk7g2KoiQoe7M2tcxp5",
      "program": "onreuGhHHgVzMWSkj2oQDLDtvvGvoepBPkqyaubFcwe"
    },
    {
      "id": "ON-F03",
      "topic": "Return sources",
      "statement": "Premium income, claims, expenses/reserves and collateral returns determine the underlying economics. Premium-bearing exposures and the collateral securing them are not independent reserves to add together.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S01",
        "ON-S08",
        "ON-S11"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F04",
      "topic": "Backing",
      "statement": "The current collateral page names eight reserve instruments without weights, balances or valuation dates. The list is insufficient to establish current allocation or materiality.",
      "classification": "document_observation",
      "source_ids": [
        "ON-S03"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F05",
      "topic": "Primary entry",
      "statement": "Issuer supports USDC and USDG for minting with no mint fee; network fees apply. Access mode determines onboarding.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S04",
        "ON-S06"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F06",
      "topic": "Primary exit",
      "statement": "Primary redemption requires KYC/accredited eligibility and a verified payout wallet. Settlement uses available USDC/USDG at execution-time offer pricing. A pending request remains exposed to ONyc; it may be cancelled before execution.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S05"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F07",
      "topic": "Liquidity terms",
      "statement": "Issuer targets reserve capital of up to 15% and monthly capacity of up to 2.5% of NAV; these are targets, not guaranteed cash availability. The stated application redemption fee is 25 basis points and may change.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S05"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null,
      "redemption_fee_bps": 25,
      "reserve_target_pct_max": 15,
      "monthly_capacity_target_nav_pct_max": 2.5
    },
    {
      "id": "ON-F08",
      "topic": "Access fallback",
      "statement": "Permissionless acquisition and eligible issuer redemption are different access paths. An ineligible holder relies on secondary liquidity for exit.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S05",
        "ON-S06"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F09",
      "topic": "Valuation control",
      "statement": "Technical reference says mint/redemption price is calculated from contract-stored base price, annual rate and elapsed time; REST mirrors state. It does not establish how economic losses reach those parameters.",
      "classification": "conflicting_documentation",
      "source_ids": [
        "ON-S02",
        "ON-S08",
        "ON-S09"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F10",
      "topic": "Administrative control",
      "statement": "Issuer describes separate 3-of-6 multisigs for reserves and administration, upgrade/freeze/fee/pause powers, and a timelock still being implemented. Configuration and signer independence are unverified.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S07"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F11",
      "topic": "Collateral custody",
      "statement": "Issuer claims legal segregation from its general account and between underwriting accounts. This does not verify account-level custodians, signed participation rights, claim priority or recoverability.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S10",
        "ON-S07"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F12",
      "topic": "Underwriting mix",
      "statement": "Portfolio policy targets approximately equal specialty and catastrophe ILW exposure; this is not an observed allocation. ILW descriptions indicate typically 6\u201312 month duration.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S11"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F13",
      "topic": "Audit evidence",
      "statement": "OtterSec report dated July 30, 2026 covers commit 8aceb86. It reports 16 findings: one medium, seven low, eight informational; nine resolved and seven acknowledged. No deployed-code match was established.",
      "classification": "independent_report_observation",
      "source_ids": [
        "ON-S14"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F14",
      "topic": "Audit limitations",
      "statement": "Acknowledged issues include cached market statistics, pricing migration, and fee rounding during partial redemption. The report records backend handling as the response to fee rounding; this is not proof of a current exploit.",
      "classification": "independent_report_observation",
      "source_ids": [
        "ON-S14"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F15",
      "topic": "Attestations",
      "statement": "The inspected issuer index lists monthly Apex reports through June 2026. June report contents were unavailable, so balances, scope, qualifications and subsequent reports remain unverified.",
      "classification": "document_observation",
      "source_ids": [
        "ON-S15",
        "ON-S16"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F16",
      "topic": "Operational assurance",
      "statement": "Issuer states SOC 2 Type II examination by BARR Advisory across Security, Availability and Confidentiality. The report itself was not obtained.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S17"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F17",
      "topic": "Regulation",
      "statement": "Issuer identifies On Re SAC Ltd, Bermuda Class F digital-asset and Class IIGB insurance permissions, registration 55347. The exact regulator entry was not independently established.",
      "classification": "issuer_claim",
      "source_ids": [
        "ON-S22",
        "ON-S21"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    },
    {
      "id": "ON-F18",
      "topic": "Risk calibration",
      "statement": "Issuer publishes an approximate 0.5% loss-probability claim without sufficient model scope, horizon and validation in the inspected page; it is excluded from rating calibration.",
      "classification": "unvalidated_issuer_model_claim",
      "source_ids": [
        "ON-S23"
      ],
      "observed_at": "2026-09-08",
      "effective_at": null
    }
