  "statements": [
    {
      "id": "EXP-F01",
      "statement": "Yield stripping creates matching PT/YT positions for a defined maturity. Matching PT plus YT can merge before maturity; PT becomes redeemable after maturity while YT stops accrual.",
      "status": "documented",
      "source_ids": [
        "EXP-YIELD"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F02",
      "statement": "Senior and junior shares are NAV claims on separate tranches. Junior provides first-loss capital; senior can lose value after junior capacity is exhausted.",
      "status": "documented",
      "source_ids": [
        "EXP-TRANCHES"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F03",
      "statement": "Underlying gains and losses are applied when a market sync occurs. During recovery senior yield and withdrawals pause; sufficiently severe losses trigger settlement.",
      "status": "documented",
      "source_ids": [
        "EXP-WATERFALL"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F04",
      "statement": "Public metadata supplies exact September and January ONyc/srONyc PT, YT, SY and vault identities; all four were marked active by the publisher API.",
      "status": "publisher_observed",
      "source_ids": [
        "EXP-API-MARKETS",
        "EXP-API-VAULTS"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F05",
      "statement": "All four markets use USD accounting metadata with 9 decimals; underlying assets differ between ONyc and srONyc. Cash output and impaired redemption amounts are unverified.",
      "status": "publisher_observed",
      "source_ids": [
        "EXP-API-MARKETS"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F06",
      "statement": "The observed coverage ratio equals junior effective NAV divided by total effective NAV, rather than junior divided by senior.",
      "status": "derived_from_publisher_api",
      "source_ids": [
        "EXP-API-TRANCHING"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F07",
      "statement": "Protocol documentation describes mutable programs, adjustable parameters and Squads multisig administration; signer identities, threshold, timelock and upgrade authorities are not verified.",
      "status": "documented",
      "source_ids": [
        "EXP-SECURITY"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F08",
      "statement": "Liquidity comes from counterparties. Early exit may fail or become costly when liquidity is thin; market-specific fees and maturity behavior vary.",
      "status": "documented",
      "source_ids": [
        "EXP-FEES"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F09",
      "statement": "Sec3 June report reviewed b45838d and lists three low plus five informational findings as resolved; deployment correspondence has not been established.",
      "status": "audit_report_observed",
      "source_ids": [
        "EXP-AUDIT-SEC3"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
      "id": "EXP-F10",
      "statement": "Accretion May report records 6 medium and 13 low findings, 12 fixed and 7 acknowledged. Its program ID differs from the current documentation and its audit-result status is unverified.",
      "status": "audit_report_observed",
      "source_ids": [
        "EXP-AUDIT-ACCRETION"
      ],
      "observed_at": "2026-09-07T19:11:43Z"
    },
    {
